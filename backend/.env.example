# Server Configuration
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:5000

# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/smart-resume-analyzer

# JWT Secret & Expiry
JWT_SECRET=your_jwt_secret_key_min_32_chars
JWT_EXPIRE=7d
SESSION_COOKIE_MAX_AGE_MS=604800000

# NLP Service Integration
NLP_SERVICE_URL=http://localhost:5001

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads
# `local` is for development only. `s3` supports private AWS S3-compatible
# storage and is required by the production configuration guard.
DOCUMENT_STORAGE_DRIVER=local
DOCUMENT_STORAGE_BUCKET=
DOCUMENT_STORAGE_ENDPOINT=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Internal Security Token (Must match INTERNAL_NLP_TOKEN in nlp-service/.env)
INTERNAL_NLP_TOKEN=your_secure_random_internal_token_here

# Background Queue & Concurrency (Redis is mandatory in production)
REDIS_URL=
# Rate-limit state uses the same Redis service in production.
QUEUE_CONCURRENCY=1
MAX_RETRIES=3
RETRY_DELAY=10000
QUEUE_RATE_LIMIT_DURATION=30000
# Set false in API-only processes and true in dedicated worker processes.
RUN_ANALYSIS_WORKER=true

# Daily quota reset policy. UTC is the only supported value until per-user
# timezone-aware quotas are introduced.
QUOTA_TIME_ZONE=UTC
