# NLP Service Configuration
PORT=5001
FLASK_ENV=development

# LLM Providers (At least one required for AI extraction and gap analysis)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
# Use documented model IDs. Comma-separate fallbacks only after provider verification.
GEMINI_MODELS=gemini-2.5-flash
GROQ_MODELS=

# Internal Security Token (Must match INTERNAL_NLP_TOKEN in backend/.env)
INTERNAL_NLP_TOKEN=your_secure_random_internal_token_here
REQUIRE_INTERNAL_AUTH=true
NLP_ALLOW_CORS=false
# Resume safety limits. Keep aligned with the backend upload limit.
MAX_PDF_PAGES=20
MAX_EXTRACTED_TEXT_CHARACTERS=200000
